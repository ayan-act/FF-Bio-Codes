  <script>
    (() => {
      const data = JSON.parse(document.getElementById('review-data').textContent), summary = data.summary, list = document.getElementById('review-list');
      const stars = rating => '★'.repeat(rating) + '☆'.repeat(5 - rating);
      document.getElementById('score').textContent = `★★★★★ ${summary.average}/5`;
      document.getElementById('rating-text').textContent = `${summary.average} out of 5 stars`;
      document.getElementById('count-text').textContent = `Based on ${summary.count.toLocaleString()} ratings`;
      document.getElementById('written-summary').textContent = `${summary.writtenCount.toLocaleString()} written submissions`;
      document.getElementById('written-count').textContent = `${summary.publicReviewCount.toLocaleString()} publicly eligible written reviews are shown below. Newest first.`;
      const distribution = document.getElementById('distribution-list');
      [5,4,3,2,1].forEach(rating => {
        const count = summary.distribution[String(rating)], percent = count / summary.count * 100, row = document.createElement('div'), label = document.createElement('span'), track = document.createElement('div'), fill = document.createElement('div'), output = document.createElement('output');
        row.className = 'rating-row'; label.textContent = `${stars(rating)} ${rating} Star`; track.className = 'track'; fill.className = 'fill'; fill.style.width = `${percent}%`; fill.setAttribute('aria-hidden','true'); output.textContent = `${count.toLocaleString()} (${percent.toFixed(1)}%)`; track.append(fill); row.append(label, track, output); distribution.append(row);
      });
      function createReviewCard(review, className) {
        const card=document.createElement('article'), starLine=document.createElement('div'), quote=document.createElement('blockquote'), meta=document.createElement('div'), author=document.createElement('b');
        card.className=className; starLine.className='stars'; starLine.setAttribute('aria-label', `${review.rating} out of 5 stars`); starLine.textContent=stars(review.rating); quote.textContent=review.feedback; meta.className='review-meta'; author.textContent='— Anonymous'; meta.append(author);
        if(review.date) { const time=document.createElement('time'); time.textContent=review.date; meta.append(time); } card.append(starLine,quote,meta); return card;
      }
      const stack=document.getElementById('featured-stack'), featuredCount=Math.min(4, data.reviews.length);
      stack.replaceChildren(...data.reviews.slice(0, featuredCount).map(review => createReviewCard(review,'stack-card')));
      // The featured cards share the editorial layout of the loaded list. Their
      // entrance is CSS-only; no continuous animation runs after they settle.
      stack.removeAttribute('tabindex');
      let shown = featuredCount; const button = document.getElementById('load-more');
      function showMore() { data.reviews.slice(shown, shown + 12).forEach(review => list.append(createReviewCard(review,'review-card'))); shown += 12; button.hidden = shown >= data.reviews.length; }
      button.addEventListener('click', showMore); showMore();
    })();
  </script>
